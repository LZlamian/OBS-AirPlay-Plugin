From e11c9de68574f001d53f4304032f94725f9d328c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 11:15:22 +0000
Subject: [PATCH 5/5] llhttp: no dllexport in the static library

On Windows LLHTTP_EXPORT is __declspec(dllexport), so every DLL that links
the static llhttp exported its 33 functions. LLHTTP_STATIC (set by the
library's CMakeLists for its users) leaves them unexported.
---
 lib/llhttp/CMakeLists.txt | 2 ++
 lib/llhttp/llhttp.h       | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/llhttp/CMakeLists.txt b/lib/llhttp/CMakeLists.txt
index cebc2a7..62e38cc 100644
--- a/lib/llhttp/CMakeLists.txt
+++ b/lib/llhttp/CMakeLists.txt
@@ -4,3 +4,5 @@ include_directories(.)
 add_library( llhttp
         STATIC
         ${DIR_SRCS})
+# Static: a DLL linking it must not export llhttp_* (obs-airplay).
+target_compile_definitions( llhttp PUBLIC LLHTTP_STATIC )
diff --git a/lib/llhttp/llhttp.h b/lib/llhttp/llhttp.h
index 6054459..4ed43fa 100644
--- a/lib/llhttp/llhttp.h
+++ b/lib/llhttp/llhttp.h
@@ -552,7 +552,7 @@ extern "C" {
 
 #if defined(__wasm__)
 #define LLHTTP_EXPORT __attribute__((visibility("default")))
-#elif defined(_WIN32)
+#elif defined(_WIN32) && !defined(LLHTTP_STATIC)
 #define LLHTTP_EXPORT __declspec(dllexport)
 #else
 #define LLHTTP_EXPORT
