From 68697b6a96d8db9246b9311571d6a050ca9e0041 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 11:12:28 +0000
Subject: [PATCH 1/4] Build uxplay/lib with MinGW-w64 (Windows x64)

- media_url_policy.h: Winsock headers; inet_aton from Windows' own lenient
  IPv4 parser (RtlIpv4StringToAddressA, Strict=FALSE), which takes the
  same short, octal and hex forms Windows resolves; link ntdll.
- media_trace.h: no memmem in the Windows C runtime.
- http_handlers.h: media spooling is POSIX-only here (ported in a later
  commit); on Windows it fails cleanly.
---
 lib/CMakeLists.txt     |  3 ++-
 lib/http_handlers.h    | 13 +++++++++++++
 lib/media_trace.h      | 12 +++++++++++-
 lib/media_url_policy.h | 17 +++++++++++++++++
 4 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/lib/CMakeLists.txt b/lib/CMakeLists.txt
index 2cf4016..00cf137 100644
--- a/lib/CMakeLists.txt
+++ b/lib/CMakeLists.txt
@@ -74,7 +74,8 @@ elseif( WIN32 )
                          llhttp
                          wsock32
 			 iphlpapi
-                         ws2_32 )
+                         ws2_32
+                         ntdll )  # RtlIpv4StringToAddressA (media_url_policy.h)
 else()
   target_link_libraries( airplay PUBLIC
           pthread
diff --git a/lib/http_handlers.h b/lib/http_handlers.h
index fe32698..4d11c31 100644
--- a/lib/http_handlers.h
+++ b/lib/http_handlers.h
@@ -146,6 +146,11 @@ spool_directory_candidates(char *user_directory, const char *candidates[3]) {
    running receiver of the same user). */
 static void
 sweep_stale_spool_files(raop_t *raop) {
+#ifdef _WIN32
+    /* nothing is spooled on Windows (spool_write_media) */
+    (void) raop;
+}
+#else
     char user_directory[MAX_SPOOL_DIRECTORY_BYTES + 1U] = {0};
     const char *candidates[3] = {NULL, NULL, NULL};
     const size_t candidate_count = spool_directory_candidates(user_directory, candidates);
@@ -180,6 +185,7 @@ sweep_stale_spool_files(raop_t *raop) {
                    "[MEDIA] removed %d stale media spool file(s)", removed);
     }
 }
+#endif
 
 /* httpd thread: room in the spool budget for `size` more bytes, counting the
    files of every item and the replies still being written (obs-airplay) */
@@ -225,6 +231,12 @@ spool_write_media(logger_t *logger, const char *data, size_t size, int delay_ms)
         log_spool_failure(logger, "validate", EINVAL);
         return NULL;
     }
+#ifdef _WIN32
+    /* Not ported: the spool file's privacy relies on POSIX modes and the
+       owner checks in the host's media policy. */
+    log_spool_failure(logger, "unsupported on Windows", ENOSYS);
+    return NULL;
+#else
     char user_directory[MAX_SPOOL_DIRECTORY_BYTES + 1U] = {0};
     const char *candidates[3] = {NULL, NULL, NULL};
     const size_t candidate_count = spool_directory_candidates(user_directory, candidates);
@@ -301,6 +313,7 @@ spool_write_media(logger_t *logger, const char *data, size_t size, int delay_ms)
     }
 
     return NULL;
+#endif
 }
 
 /* A reverse-fetched media reply waiting to be written, being written, or
diff --git a/lib/media_trace.h b/lib/media_trace.h
index 0561163..3b905e8 100644
--- a/lib/media_trace.h
+++ b/lib/media_trace.h
@@ -285,6 +285,16 @@ media_trace_emit(raop_t *raop, const char *prefix, media_trace_buf_t *b) {
 }
 
 /* Append a decoded body: binary plist, XML plist, text, or a hex preview. */
+
+/* "&#" in a body (memmem is not in the Windows C runtime) */
+static bool
+media_trace_has_entity(const char *data, size_t size) {
+    for (size_t i = 0; i + 1 < size; ++i) {
+        if (data[i] == '&' && data[i + 1] == '#') return true;
+    }
+    return false;
+}
+
 static void
 media_trace_append_body(media_trace_buf_t *b, const char *content_type,
                         const char *data, int datalen) {
@@ -299,7 +309,7 @@ media_trace_append_body(media_trace_buf_t *b, const char *content_type,
         if (is_bplist) plist_from_bin_checked(data, (uint32_t) datalen, &root);
         /* (obs-airplay) &#0; would put a NUL in a string: such XML is not
            parsed for the trace */
-        else if (!memmem(data, (size_t) datalen, "&#", 2)) plist_from_xml(data, (uint32_t) datalen, &root);
+        else if (!media_trace_has_entity(data, (size_t) datalen)) plist_from_xml(data, (uint32_t) datalen, &root);
         if (root) {
             media_trace_append(b, " body=%s ", is_bplist ? "bplist" : "xml-plist");
             media_trace_append_plist(b, root, 0);
diff --git a/lib/media_url_policy.h b/lib/media_url_policy.h
index e3660f4..c571e3a 100644
--- a/lib/media_url_policy.h
+++ b/lib/media_url_policy.h
@@ -19,11 +19,28 @@
 #ifndef MEDIA_URL_POLICY_H
 #define MEDIA_URL_POLICY_H
 
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <mstcpip.h>
+#else
 #include <arpa/inet.h>
 #include <netinet/in.h>
+#endif
 #include <stdint.h>
 #include <strings.h>
 
+#ifdef _WIN32
+/* Windows has no inet_aton; its own lenient IPv4 parser (what its resolver
+   uses for numeric hosts) takes the same short, octal and hex forms. */
+static int
+media_inet_aton(const char *text, struct in_addr *address) {
+    LPSTR end = NULL;
+    return RtlIpv4StringToAddressA(text, FALSE, &end, address) == 0 && end && *end == '\0';
+}
+#define inet_aton media_inet_aton
+#endif
+
 #define MEDIA_URL_HOST_BYTES 256
 
 typedef enum {
