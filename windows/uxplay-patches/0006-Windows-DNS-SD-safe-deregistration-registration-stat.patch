From 0dc6187163fbd57b1b629bc25558b1b79db7afe3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 17:58:38 +0800
Subject: [PATCH] Windows DNS-SD: safe deregistration, registration status,
 Bonjour check

- A service is freed only when no completion callback is still to
  come: registration and deregistration report through the same
  callback, and the single auto-reset event let a late registration
  completion release the deregistration wait (use after free).
- dnssd_get_registration_status reports the Windows DNS service's
  asynchronous result (pending, announced, or the error), which was
  stored and never read.
- Bonjour's dnssd.dll is loaded from System32 only, and used only while
  the Bonjour service answers (DNSServiceGetProperty DaemonVersion);
  with it stopped the Windows DNS service registers instead.
  UXPLAY_DNSSD_DLL names another file for tests.
- A dot in the receiver name no longer splits the instance name: it is
  advertised as U+2024 ONE DOT LEADER.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 lib/dnssd.c       | 46 ++++++++++++++++++++++++++++-
 lib/dnssd.h       |  8 ++++++
 lib/dnssd_win32.c | 73 ++++++++++++++++++++++++++++++++++++-----------
 lib/dnssd_win32.h |  4 +++
 4 files changed, 113 insertions(+), 18 deletions(-)

diff --git a/lib/dnssd.c b/lib/dnssd.c
index c9208d2..5aed7d9 100644
--- a/lib/dnssd.c
+++ b/lib/dnssd.c
@@ -122,6 +122,34 @@ typedef uint16_t (DNSSD_STDCALL *TXTRecordGetLength_t)(const TXTRecordRef *txtRe
 typedef const void * (DNSSD_STDCALL *TXTRecordGetBytesPtr_t)(const TXTRecordRef *txtRecord);
 
 
+#ifdef WIN32
+typedef DNSServiceErrorType (DNSSD_STDCALL *DNSServiceGetProperty_t)(const char *property,
+                                                                      void *result,
+                                                                      uint32_t *size);
+
+/* Bonjour's dnssd.dll from System32, not the application's folder, and only
+   while the Bonjour service runs: with it stopped every registration fails,
+   so the Windows DNS service is used instead (obs-airplay).
+   UXPLAY_DNSSD_DLL names another file (tests). */
+static HMODULE
+load_bonjour(void) {
+    const char *path = getenv("UXPLAY_DNSSD_DLL");
+    HMODULE module = path && *path
+        ? LoadLibraryA(path)
+        : LoadLibraryExA("dnssd.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    if (!module) return NULL;
+    DNSServiceGetProperty_t get_property =
+        (DNSServiceGetProperty_t) (void *) GetProcAddress(module, "DNSServiceGetProperty");
+    uint32_t version = 0;
+    uint32_t size = sizeof(version);
+    if (!get_property || get_property("DaemonVersion", &version, &size) != kDNSServiceErr_NoError) {
+        FreeLibrary(module);
+        return NULL;
+    }
+    return module;
+}
+#endif
+
 struct dnssd_s {
 #ifdef WIN32
     HMODULE module;            /* Bonjour's dnssd.dll, or NULL: Windows DNS service */
@@ -204,7 +232,7 @@ dnssd_init(const char* name, int name_len, const char* hw_addr, int hw_addr_len,
     const char *backend = getenv("UXPLAY_DNSSD_BACKEND");
     const bool bonjour_allowed = !backend || strcmp(backend, "windows") != 0;
     const bool native_allowed = !backend || strcmp(backend, "bonjour") != 0;
-    dnssd->module = bonjour_allowed ? LoadLibraryA("dnssd.dll") : NULL;
+    dnssd->module = bonjour_allowed ? load_bonjour() : NULL;
 	if (!dnssd->module) {
 		dnssd_win32_functions_t native;
 		if (!native_allowed || !dnssd_win32_native(&native)) {
@@ -570,6 +598,22 @@ void dnssd_set_airplay_features(dnssd_t *dnssd, int bit, int val) {
     }
 }
 
+int
+dnssd_get_registration_status(dnssd_t *dnssd) {
+#ifdef WIN32
+    if (dnssd && !dnssd->module) {
+        const long raop = dnssd_win32_registration_status(dnssd->raop_service);
+        const long airplay = dnssd_win32_registration_status(dnssd->airplay_service);
+        if (raop > 0) return (int) raop;
+        if (airplay > 0) return (int) airplay;
+        if (raop < 0 || airplay < 0) return DNSSD_REGISTRATION_PENDING;
+    }
+#else
+    (void) dnssd;
+#endif
+    return 0;
+}
+
 const char *
 dnssd_get_backend(dnssd_t *dnssd) {
 #ifdef WIN32
diff --git a/lib/dnssd.h b/lib/dnssd.h
index 32b7932..008584d 100644
--- a/lib/dnssd.h
+++ b/lib/dnssd.h
@@ -54,6 +54,14 @@ DNSSD_API void dnssd_set_pk(dnssd_t *dnssd, char * pk_str);
 /* Which DNS-SD implementation registers the services (for logs). */
 DNSSD_API const char *dnssd_get_backend(dnssd_t *dnssd);
 
+/* The Windows DNS service completes registrations later: 0 once the
+   registered services are announced, DNSSD_REGISTRATION_PENDING until then,
+   or the Windows error code of one that failed (a name conflict, mDNS
+   turned off). Other backends report failures from dnssd_register_* and
+   always return 0. */
+#define DNSSD_REGISTRATION_PENDING (-1)
+DNSSD_API int dnssd_get_registration_status(dnssd_t *dnssd);
+
 DNSSD_API void dnssd_destroy(dnssd_t *dnssd);
 
 #ifdef __cplusplus
diff --git a/lib/dnssd_win32.c b/lib/dnssd_win32.c
index 1a3be28..876770c 100644
--- a/lib/dnssd_win32.c
+++ b/lib/dnssd_win32.c
@@ -23,6 +23,7 @@
 
 #define TXT_MAX_ITEMS 64
 #define DEREGISTER_WAIT_MS 2000
+#define DEREGISTER_POLL_MS 10
 
 typedef PDNS_SERVICE_INSTANCE (WINAPI *construct_instance_t)(PCWSTR, PCWSTR, PIP4_ADDRESS,
                                                              PIP6_ADDRESS, WORD, WORD, WORD,
@@ -35,12 +36,16 @@ static register_t service_register;
 static register_t service_deregister;
 static free_instance_t free_instance;
 
-/* dns_sd.h leaves the service reference opaque; this is ours. */
+/* dns_sd.h leaves the service reference opaque; this is ours.
+   Registration and deregistration report through the same callback, in
+   either order: the service is freed only when no callback is still to
+   come, which the callback's last access (the decrement) tells. */
 struct _DNSServiceRef_t {
     DNS_SERVICE_REGISTER_REQUEST request;
     PDNS_SERVICE_INSTANCE instance;
-    HANDLE completed;            /* set by every completion callback */
-    volatile LONG status;        /* last completion status */
+    volatile LONG outstanding;   /* completion callbacks still to come */
+    volatile LONG answered;      /* the registration's callback has run */
+    volatile LONG status;        /* its status */
 };
 
 /* TXTRecordRef is 16 opaque bytes: they hold a pointer to this. */
@@ -125,18 +130,45 @@ static void WINAPI
 register_complete(DWORD status, PVOID context, PDNS_SERVICE_INSTANCE instance) {
     DNSServiceRef service = context;
     if (instance) free_instance(instance);  /* the callback owns this copy */
-    InterlockedExchange(&service->status, (LONG) status);
-    SetEvent(service->completed);
+    /* The first callback answers the registration. */
+    if (InterlockedCompareExchange(&service->answered, 1, 0) == 0) {
+        InterlockedExchange(&service->status, (LONG) status);
+    }
+    /* Last access: the service may be freed as soon as this reaches 0. */
+    InterlockedDecrement(&service->outstanding);
 }
 
 static void
 service_free(DNSServiceRef service) {
     if (!service) return;
     if (service->instance) free_instance(service->instance);
-    if (service->completed) CloseHandle(service->completed);
     free(service);
 }
 
+long
+dnssd_win32_registration_status(DNSServiceRef service) {
+    if (!service) return 0;
+    if (!InterlockedCompareExchange(&service->answered, 0, 0)) return -1;
+    return (long) InterlockedCompareExchange(&service->status, 0, 0);
+}
+
+/* A label of the instance name: DnsServiceConstructInstance splits the
+   whole name at every '.', so a dot in it becomes U+2024 ONE DOT LEADER,
+   which looks the same. Bonjour escapes dots itself. */
+static bool
+instance_label(const char *name, char *label, size_t size) {
+    size_t length = 0;
+    for (const char *c = name; *c; ++c) {
+        const char *part = *c == '.' ? "\xe2\x80\xa4" : c;
+        const size_t part_length = *c == '.' ? 3U : 1U;
+        if (length + part_length >= size) return false;
+        memcpy(label + length, part, part_length);
+        length += part_length;
+    }
+    label[length] = '\0';
+    return length > 0;
+}
+
 static DNSServiceErrorType DNSSD_API
 native_register(DNSServiceRef *reference, DNSServiceFlags flags, uint32_t interface_index,
                 const char *name, const char *type, const char *domain, const char *host,
@@ -150,8 +182,10 @@ native_register(DNSServiceRef *reference, DNSServiceFlags flags, uint32_t interf
     if (!name || !type) return kDNSServiceErr_BadParam;
 
     /* "<name>.<type>.<domain>" and "<computer>.local" */
-    char instance_name[512];
-    const int written = snprintf(instance_name, sizeof(instance_name), "%s.%s.%s", name, type,
+    char label[256 * 3];
+    if (!instance_label(name, label, sizeof(label))) return kDNSServiceErr_BadParam;
+    char instance_name[1024];
+    const int written = snprintf(instance_name, sizeof(instance_name), "%s.%s.%s", label, type,
                                  domain && *domain ? domain : "local");
     if (written <= 0 || (size_t) written >= sizeof(instance_name)) return kDNSServiceErr_BadParam;
     wchar_t computer[256];
@@ -194,8 +228,7 @@ native_register(DNSServiceRef *reference, DNSServiceFlags flags, uint32_t interf
     if (!error && !wide_name) error = kDNSServiceErr_BadParam;
     if (!error) {
         service = calloc(1, sizeof(*service));
-        if (service) service->completed = CreateEventW(NULL, FALSE, FALSE, NULL);
-        if (!service || !service->completed) error = kDNSServiceErr_NoMemory;
+        if (!service) error = kDNSServiceErr_NoMemory;
     }
     if (!error) {
         /* the port arrives in network byte order */
@@ -211,6 +244,7 @@ native_register(DNSServiceRef *reference, DNSServiceFlags flags, uint32_t interf
 
     if (!error) {
         service->status = DNS_REQUEST_PENDING;
+        service->outstanding = 1;
         service->request.Version = DNS_QUERY_REQUEST_VERSION1;
         service->request.InterfaceIndex = interface_index;
         service->request.pServiceInstance = service->instance;
@@ -219,6 +253,7 @@ native_register(DNSServiceRef *reference, DNSServiceFlags flags, uint32_t interf
         service->request.unicastEnabled = FALSE;
         const DWORD result = service_register(&service->request, NULL);
         if (result != DNS_REQUEST_PENDING) {
+            service->outstanding = 0;  /* no callback comes */
             error = result == ERROR_SERVICE_NOT_ACTIVE ? kDNSServiceErr_ServiceNotRunning
                                                        : kDNSServiceErr_Unknown;
         }
@@ -234,14 +269,18 @@ native_register(DNSServiceRef *reference, DNSServiceFlags flags, uint32_t interf
 static void DNSSD_API
 native_deallocate(DNSServiceRef service) {
     if (!service) return;
-    ResetEvent(service->completed);
+    /* Counted before the call: its callback may run before it returns. */
+    InterlockedIncrement(&service->outstanding);
     const DWORD result = service_deregister(&service->request, NULL);
-    /* The completion callback still refers to the service: free it only
-       once deregistration has completed, else leave it (a few hundred
-       bytes) rather than risk a late callback into freed memory. */
-    if (result == DNS_REQUEST_PENDING &&
-        WaitForSingleObject(service->completed, DEREGISTER_WAIT_MS) != WAIT_OBJECT_0) {
-        return;
+    if (result != DNS_REQUEST_PENDING) InterlockedDecrement(&service->outstanding);
+    /* Callbacks (this deregistration's, and a registration's still in
+       progress) refer to the service: free it only once none is left to
+       come, else leave it (a few hundred bytes) rather than risk a late
+       callback into freed memory. */
+    for (DWORD waited = 0; InterlockedCompareExchange(&service->outstanding, 0, 0) > 0;
+         waited += DEREGISTER_POLL_MS) {
+        if (waited >= DEREGISTER_WAIT_MS) return;
+        Sleep(DEREGISTER_POLL_MS);
     }
     service_free(service);
 }
diff --git a/lib/dnssd_win32.h b/lib/dnssd_win32.h
index e7658ae..c04f97d 100644
--- a/lib/dnssd_win32.h
+++ b/lib/dnssd_win32.h
@@ -30,6 +30,10 @@ typedef struct {
 /* Fills `functions` when the Windows DNS service API exists (dnsapi.dll on
    Windows 10 1809+); false otherwise. */
 bool dnssd_win32_native(dnssd_win32_functions_t *functions);
+
+/* A service registered through those functions: -1 until its registration
+   completed, then the completion status (0 when it succeeded). */
+long dnssd_win32_registration_status(DNSServiceRef service);
 #endif
 
 #endif
-- 
