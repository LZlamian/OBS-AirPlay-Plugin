 lib/airplay_video.c |   5 +-
 lib/http_handlers.h |  29 ++++----
 lib/spool_file.h    |  68 ++++++++++++++++++
 lib/spool_win32.c   | 166 ++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 255 insertions(+), 17 deletions(-)
 create mode 100644 lib/spool_file.h
 create mode 100644 lib/spool_win32.c

